{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dalgona/workspace/read result",
  "type": "object",
  "required": [
    "revision",
    "total",
    "offset",
    "next",
    "dataBase64"
  ],
  "properties": {
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "total": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "offset": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "next": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "dataBase64": {
      "type": "string"
    }
  }
}
