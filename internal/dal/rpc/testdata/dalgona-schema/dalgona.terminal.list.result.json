{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dalgona/terminal/list result",
  "type": "object",
  "required": [
    "terminals"
  ],
  "properties": {
    "terminals": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "identity",
          "status",
          "writerPresent",
          "leaseExpiresAt"
        ],
        "properties": {
          "identity": {
            "type": "object",
            "required": [
              "terminalId",
              "daemonInstanceId",
              "threadId",
              "runnerId",
              "bindingRevision",
              "root"
            ],
            "properties": {
              "terminalId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "daemonInstanceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "threadId": {
                "type": "string"
              },
              "runnerId": {
                "type": "string"
              },
              "bindingRevision": {
                "type": "string"
              },
              "root": {
                "type": "string"
              }
            }
          },
          "status": {
            "type": "object",
            "required": [
              "state",
              "inputState"
            ],
            "properties": {
              "state": {
                "enum": [
                  "running",
                  "exited",
                  "closed"
                ]
              },
              "inputState": {
                "enum": [
                  "ready",
                  "uncertain",
                  "closed"
                ]
              },
              "exitCode": {
                "type": "integer"
              },
              "signal": {
                "type": "string"
              },
              "finalOffset": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "finalResizeOrdinal": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "outputTruncated": {
                "type": "boolean"
              },
              "outputExpiresAt": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
              }
            }
          },
          "writerPresent": {
            "type": "boolean"
          },
          "leaseExpiresAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          }
        }
      }
    }
  }
}
