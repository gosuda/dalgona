{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dalgona/history/page params",
  "type": "object",
  "required": [
    "historyId"
  ],
  "properties": {
    "historyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "cursor": {
      "type": "string"
    },
    "direction": {
      "enum": [
        "older",
        "newer"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  }
}
