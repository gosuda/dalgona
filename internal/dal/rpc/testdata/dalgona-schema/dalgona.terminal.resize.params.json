{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dalgona/terminal/resize params",
  "type": "object",
  "required": [
    "terminalId",
    "writerLease",
    "resizeSeq",
    "columns",
    "rows"
  ],
  "properties": {
    "terminalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "writerLease": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "resizeSeq": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "columns": {
      "type": "integer",
      "minimum": 20,
      "maximum": 240
    },
    "rows": {
      "type": "integer",
      "minimum": 5,
      "maximum": 120
    }
  }
}
