{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dalgona/terminal/open params",
  "type": "object",
  "required": [
    "workspaceId",
    "columns",
    "rows",
    "operationId"
  ],
  "properties": {
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "columns": {
      "type": "integer",
      "minimum": 20,
      "maximum": 240
    },
    "rows": {
      "type": "integer",
      "minimum": 5,
      "maximum": 120
    },
    "operationId": {
      "type": "string"
    }
  }
}
