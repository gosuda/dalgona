{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dalgona/workspace/list result",
  "type": "object",
  "required": [
    "entries",
    "directoryRevision"
  ],
  "properties": {
    "entries": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "size",
          "modifiedAt",
          "revision",
          "readable",
          "writable"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "file",
              "directory",
              "symlink",
              "other"
            ]
          },
          "size": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "modifiedAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "readable": {
            "type": "boolean"
          },
          "writable": {
            "type": "boolean"
          }
        }
      }
    },
    "nextCursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "directoryRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
