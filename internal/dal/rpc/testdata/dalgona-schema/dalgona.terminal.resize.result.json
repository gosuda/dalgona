{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dalgona/terminal/resize result",
  "type": "object",
  "required": [
    "acceptedSeq",
    "ordinal",
    "offset",
    "columns",
    "rows"
  ],
  "properties": {
    "acceptedSeq": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "ordinal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "offset": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "columns": {
      "type": "integer",
      "minimum": 20,
      "maximum": 240
    },
    "rows": {
      "type": "integer",
      "minimum": 5,
      "maximum": 120
    }
  }
}
