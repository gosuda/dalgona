{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dalgona/workspace/write result",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "uploadId",
        "offset",
        "expiresAt"
      ],
      "properties": {
        "uploadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "offset": {
          "const": "0"
        },
        "expiresAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "next"
      ],
      "properties": {
        "next": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      },
      "not": {
        "required": [
          "uploadId"
        ]
      }
    },
    {
      "type": "object",
      "required": [
        "metadata"
      ],
      "properties": {
        "metadata": {
          "type": "object",
          "required": [
            "name",
            "kind",
            "size",
            "modifiedAt",
            "revision",
            "readable",
            "writable"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "file",
                "directory",
                "symlink",
                "other"
              ]
            },
            "size": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "modifiedAt": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "readable": {
              "type": "boolean"
            },
            "writable": {
              "type": "boolean"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "aborted"
      ],
      "properties": {
        "aborted": {
          "const": true
        }
      }
    }
  ]
}
