{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dalgona/history/content/read result",
  "type": "object",
  "required": [
    "dataBase64",
    "offset",
    "next",
    "total",
    "digest"
  ],
  "properties": {
    "dataBase64": {
      "type": "string"
    },
    "offset": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "next": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "total": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
