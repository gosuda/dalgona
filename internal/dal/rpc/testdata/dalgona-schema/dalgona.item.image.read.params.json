{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dalgona/item/image/read params",
  "type": "object",
  "required": [
    "threadId",
    "turnId",
    "itemId",
    "imageIndex"
  ],
  "properties": {
    "threadId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "turnId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "itemId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "imageIndex": {
      "type": "integer",
      "minimum": 0
    },
    "offset": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    }
  }
}
