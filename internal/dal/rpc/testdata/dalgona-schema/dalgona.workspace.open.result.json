{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dalgona/workspace/open result",
  "type": "object",
  "required": [
    "workspaceId",
    "threadId",
    "runnerId",
    "bindingRevision",
    "root",
    "pathStyle",
    "rights",
    "expiresAt"
  ],
  "properties": {
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "threadId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "runnerId": {
      "type": "string"
    },
    "bindingRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "pathStyle": {
      "enum": [
        "posix",
        "windows"
      ]
    },
    "rights": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "read",
          "write",
          "terminal"
        ]
      }
    },
    "expiresAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
