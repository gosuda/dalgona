{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dalgona/workspace/search result",
  "type": "object",
  "required": [
    "entries",
    "incomplete"
  ],
  "properties": {
    "entries": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "path",
          "score",
          "matches"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "integer",
            "minimum": 0
          },
          "matches": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "end": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                }
              }
            }
          }
        }
      }
    },
    "nextCursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "incomplete": {
      "type": "boolean"
    }
  }
}
