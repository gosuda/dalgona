{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dalgona/workspace/changed",
  "type": "object",
  "required": [
    "watchId",
    "directoryRevision",
    "paths",
    "rescanRequired"
  ],
  "properties": {
    "watchId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "directoryRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "paths": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rescanRequired": {
      "type": "boolean"
    }
  }
}
