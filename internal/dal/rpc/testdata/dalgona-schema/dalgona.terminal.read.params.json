{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dalgona/terminal/read params",
  "type": "object",
  "required": [
    "terminalId",
    "attachmentId",
    "offset",
    "afterResizeOrdinal"
  ],
  "properties": {
    "terminalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attachmentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "offset": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "afterResizeOrdinal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    },
    "waitMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    }
  }
}
