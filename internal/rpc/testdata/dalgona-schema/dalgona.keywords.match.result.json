{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dalgona/keywords/match result",
  "type": "object",
  "required": ["matches"],
  "properties": {
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["word", "byteRange", "hue", "summary"],
        "properties": {
          "word": {"type": "string"},
          "byteRange": {
            "type": "object",
            "required": ["start", "end"],
            "properties": {
              "start": {"type": "integer", "minimum": 0},
              "end": {"type": "integer", "minimum": 0}
            }
          },
          "hue": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
          "effort": {"type": "string", "enum": ["max"]},
          "summary": {"type": "string"}
        }
      }
    }
  }
}
