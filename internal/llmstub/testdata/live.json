{
 "models": [
  {
   "id": "qwen-test",
   "context_length": 32000,
   "architecture": {
    "input_modalities": [
     "text",
     "image"
    ]
   }
  },
  {
   "id": "qwen-small",
   "context_length": 8000
  }
 ],
 "turns": [
  {
   "id": "t-judge",
   "when": {
    "any_text": "\"off_task\""
   },
   "steps": [
    {
     "text": "{\"sound\":0.04,\"lost_code\":0.97,\"placeholder\":0.02,\"off_task\":0.01}"
    },
    {
     "finish": "stop"
    }
   ]
  },
  {
   "id": "t-judge-turn",
   "when": {
    "any_text": "\"incomplete\""
   },
   "steps": [
    {
     "text": "{\"sound\":0.04,\"incomplete\":0.03}"
    },
    {
     "finish": "stop"
    }
   ]
  },
  {
   "id": "t-compact",
   "when": {
    "any_text": "ummar"
   },
   "once": true,
   "steps": [
    {
     "text": "Summary: the user read a.txt and edited notes.md."
    },
    {
     "finish": "stop",
     "usage": {
      "prompt_tokens": 900,
      "completion_tokens": 30
     }
    }
   ]
  },
  {
   "id": "t-md",
   "when": {
    "user": "show markdown"
   },
   "steps": [
    {
     "reasoning": "Planning the answer."
    },
    {
     "delay_ms": 300
    },
    {
     "reasoning": "Planning the answer."
    },
    {
     "delay_ms": 300
    },
    {
     "reasoning": "Planning the answer."
    },
    {
     "text": "## Heading\n\n- one\n- two\n- three\n\n```go\npackage main\n\nimport \"fmt\"\n\nfunc main() {\n\tx := 1\n\tfmt.Println(\"hello\", x)\n}\n```\n\n| a | b | c |\n|---|---|---|\n| 1 | 2 | 3 |\n| 4 | 5 | 6 |\n\nabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghij\n\n달고나 테스트 문장입니다\n\n\u001b]0;pwned\u0007\u001b[2Jafter\n"
    },
    {
     "finish": "stop",
     "usage": {
      "prompt_tokens": 1200,
      "completion_tokens": 340
     }
    }
   ]
  },
  {
   "id": "t-read",
   "when": {
    "user": "read a.txt"
   },
   "steps": [
    {
     "reasoning": "Look at the file."
    },
    {
     "text": "checking"
    },
    {
     "tool_call": {
      "id": "call-read",
      "name": "read",
      "arguments": {
       "path": "a.txt"
      },
      "chunks": 3
     }
    },
    {
     "finish": "tool_calls",
     "usage": {
      "prompt_tokens": 1200,
      "completion_tokens": 40
     }
    }
   ]
  },
  {
   "id": "t-read-2",
   "when": {
    "tool_result": "call-read"
   },
   "steps": [
    {
     "text": "a.txt says hello."
    },
    {
     "finish": "stop",
     "usage": {
      "prompt_tokens": 1300,
      "completion_tokens": 12
     }
    }
   ]
  },
  {
   "id": "t-exec",
   "when": {
    "user": "run the counter"
   },
   "steps": [
    {
     "tool_call": {
      "id": "call-exec",
      "name": "exec",
      "arguments": {
       "command": "seq 1 40"
      }
     }
    },
    {
     "finish": "tool_calls"
    }
   ]
  },
  {
   "id": "t-exec-2",
   "when": {
    "tool_result": "call-exec"
   },
   "steps": [
    {
     "text": "40 lines."
    },
    {
     "finish": "stop"
    }
   ]
  },
  {
   "id": "t-exec-fail",
   "when": {
    "user": "run a failing command"
   },
   "steps": [
    {
     "tool_call": {
      "id": "call-fail",
      "name": "exec",
      "arguments": {
       "command": "sh -c 'seq 1 30; echo boom >&2; exit 3'"
      }
     }
    },
    {
     "finish": "tool_calls"
    }
   ]
  },
  {
   "id": "t-exec-fail-2",
   "when": {
    "tool_result": "call-fail"
   },
   "steps": [
    {
     "text": "It failed with exit 3."
    },
    {
     "finish": "stop"
    }
   ]
  },
  {
   "id": "t-long-cmd",
   "when": {
    "user": "approve a long command"
   },
   "steps": [
    {
     "tool_call": {
      "id": "call-long",
      "name": "exec",
      "arguments": {
       "command": "seq 1 50|sed 's/^/line /'"
      }
     }
    },
    {
     "finish": "tool_calls"
    }
   ]
  },
  {
   "id": "t-long-cmd-2",
   "when": {
    "tool_result": "call-long"
   },
   "steps": [
    {
     "text": "ok"
    },
    {
     "finish": "stop"
    }
   ]
  },
  {
   "id": "t-patch",
   "when": {
    "user": "edit notes"
   },
   "steps": [
    {
     "tool_call": {
      "id": "call-patch",
      "name": "apply_patch",
      "arguments": {
       "input": "*** Begin Patch\n*** Update File: notes.md\n@@\n-old line\n+new line\n*** End Patch\n"
      }
     }
    },
    {
     "finish": "tool_calls"
    }
   ]
  },
  {
   "id": "t-patch-2",
   "when": {
    "tool_result": "call-patch"
   },
   "steps": [
    {
     "text": "Edited notes.md."
    },
    {
     "finish": "stop"
    }
   ]
  },
  {
   "id": "t-plan",
   "when": {
    "user": "make a plan"
   },
   "steps": [
    {
     "tool_call": {
      "id": "call-plan",
      "name": "eval",
      "arguments": {
       "code": "tools.todo(items = [{'text': 'Read the code', 'status': 'done'}, {'text': 'Write the fix', 'status': 'in_progress'}, {'text': 'Run the tests', 'status': 'pending'}])"
      }
     }
    },
    {
     "finish": "tool_calls"
    }
   ]
  },
  {
   "id": "t-plan-2",
   "when": {
    "tool_result": "call-plan"
   },
   "steps": [
    {
     "text": "Plan set."
    },
    {
     "finish": "stop"
    }
   ]
  },
  {
   "id": "t-sub",
   "when": {
    "user": "spawn a helper"
   },
   "steps": [
    {
     "tool_call": {
      "id": "call-sub",
      "name": "eval",
      "arguments": {
       "code": "tools.task(prompt = 'helper task: count files')"
      }
     }
    },
    {
     "finish": "tool_calls"
    }
   ]
  },
  {
   "id": "t-sub-2",
   "when": {
    "tool_result": "call-sub"
   },
   "steps": [
    {
     "text": "The helper counted 5 files."
    },
    {
     "finish": "stop"
    }
   ]
  },
  {
   "id": "t-ask",
   "when": {
    "user": "ask me"
   },
   "steps": [
    {
     "tool_call": {
      "id": "call-ask",
      "name": "ask",
      "arguments": {
       "questions": [
        {
         "header": "Colour",
         "question": "Which colour?",
         "options": [
          {
           "label": "Orange",
           "description": "Warm.",
           "preview": "orange"
          },
          {
           "label": "Slate",
           "description": "Cool."
          }
         ]
        },
        {
         "header": "Files",
         "question": "Which files?",
         "multi_select": true,
         "options": [
          {
           "label": "a.txt",
           "description": "The notes file."
          },
          {
           "label": "notes.md",
           "description": "The markdown file."
          },
          {
           "label": "src/main.go",
           "description": "The program."
          }
         ]
        }
       ]
      }
     }
    },
    {
     "finish": "tool_calls"
    }
   ]
  },
  {
   "id": "t-ask-2",
   "when": {
    "tool_result": "call-ask"
   },
   "steps": [
    {
     "text": "Thanks."
