  {
   "id": "t-exec-300",
   "when": {
    "user": "count to 300"
   },
   "steps": [
    {
     "tool_call": {
      "id": "call-exec300",
      "name": "exec",
      "arguments": {
       "command": "seq 1 300"
      }
     }
    },
    {
     "finish": "tool_calls"
    }
   ]
  },
  {
   "id": "t-exec-300-2",
   "when": {
    "tool_result": "call-exec300"
   },
   "steps": [
    {
     "text": "300 lines."
    },
    {
     "finish": "stop"
    }
   ]
  },
  {
   "id": "t-ratchet",
   "when": {
    "user": "start a ratchet"
   },
   "steps": [
    {
     "tool_call": {
      "id": "call-ratchet",
      "name": "ratchet",
      "arguments": {
       "action": "init",
       "flow": "live",
       "cases": [
        "a.txt"
       ],
       "harness": [
        "notes.md"
       ],
       "change": [
        "notes.md"
       ]
      }
     }
    },
    {
     "finish": "tool_calls"
    }
   ]
  },
  {
   "id": "t-ratchet-2",
   "when": {
    "tool_result": "call-ratchet"
   },
   "steps": [
    {
     "text": "Ratchet round done."
    },
    {
     "finish": "stop"
    }
   ]
  },
  {
   "id": "t-image",
   "when": {
    "user": "describe the image"
   },
   "steps": [
    {
     "text": "A single pixel."
    },
    {
     "finish": "stop"
    }
   ]
  },
  {
   "id": "t-followup",
   "when": {
    "user": "and then this"
   },
   "steps": [
    {
     "text": "Noted."
    },
    {
     "finish": "stop"
    }
   ]
  },
  {
   "id": "t-slash",
   "when": {
    "user": "/etc/hosts is a path"
   },
   "steps": [
    {
     "text": "Path noted."
    },
    {
     "finish": "stop"
    }
   ]
  },
  {
   "id": "t-paste",
   "when": {
    "any_text": "PASTE-MARK-30"
   },
   "steps": [
    {
     "text": "Got 30 lines."
    },
    {
     "finish": "stop"
    }
   ]
  },
  {
   "id": "t-multi",
   "when": {
    "any_text": "first line\nsecond line"
   },
   "steps": [
    {
     "text": "Got two lines."
    },
    {
     "finish": "stop"
    }
   ]
  },
  {
   "id": "t-sub-child",
   "when": {
    "any_text": "helper task: count files"
   },
   "steps": [
    {
     "tool_call": {
      "id": "call-child-yield",
      "name": "yield",
      "arguments": {
       "data": "There are 5 files."
      }
     }
    },
    {
     "finish": "tool_calls"
    }
   ]
  }
 ]
